#!/bin/sh
set -eu
CONFIG_DIR="/root/.config/palorder"
mkdir -p "$CONFIG_DIR"
SETTINGS="$CONFIG_DIR/settings"
IDENTITY="$CONFIG_DIR/identity"
[ -f "$SETTINGS" ] || printf '%s\n' 'THEME=midnight' 'SHOW_BANNER=1' > "$SETTINGS"
[ -f "$IDENTITY" ] || printf '%s\n' 'Palorder User' > "$IDENTITY"
write_setting() {
  key=$1 value=$2 tmp="$SETTINGS.tmp.$$"
  awk -F= -v key="$key" '$1 != key {print}' "$SETTINGS" > "$tmp"
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$SETTINGS"
}
while :; do
  choice=$(dialog --clear --title "Palorder Setup Wizard" --menu "First-run assistant — choose a step. Settings are saved under /root/.config/palorder." 19 68 8 \
    "identity" "1. Identity and welcome name" \
    "theme" "2. Theme and splash screen" \
    "packages" "3. Install common tools" \
    "git" "4. Git identity and setup" \
    "workspace" "5. Workspace directory" \
    "updates" "6. Update preferences" \
    "diagnostics" "7. Environment diagnostics" \
    "finish" "Finish wizard" 3>&1 1>&2 2>&3) || exit 0
  case "$choice" in
    identity)
      old=$(cat "$IDENTITY")
      name=$(dialog --stdout --title "Identity" --inputbox "Name shown on the splash screen:" 10 58 "$old") || continue
      [ -n "$name" ] || { dialog --title "Invalid name" --msgbox "Name cannot be empty." 7 40; continue; }
      printf '%s\n' "$name" > "$IDENTITY"
      dialog --title "Saved" --msgbox "Welcome name saved." 7 40 ;;
    theme)
      selected=$(dialog --stdout --title "Theme" --menu "Choose the interface palette:" 15 54 5 \
        "midnight" "Midnight / Cyan" "violet" "Violet" "amber" "Amber" "emerald" "Emerald" "mono" "Monochrome" 3>&1 1>&2 2>&3) || continue
      write_setting THEME "$selected"
      banner=$(dialog --stdout --title "Splash screen" --menu "Show the Palorder splash banner at startup?" 10 52 2 "1" "Show splash" "0" "Hide splash" 3>&1 1>&2 2>&3) || continue
      write_setting SHOW_BANNER "$banner" ;;
    packages)
      if dialog --title "Common tools" --yesno "Install git, Python, pip, nano, less, OpenSSH client, curl and CA certificates?" 10 64; then
        if dialog --title "Installing tools" --yesno "Proceed with apk add? Package output will be written to /root/.config/palorder/setup.log." 9 60; then
          if apk add --no-cache git python3 py3-pip nano less openssh-client curl ca-certificates > "$CONFIG_DIR/setup.log" 2>&1; then
            dialog --title "Complete" --msgbox "Packages installed. Log: $CONFIG_DIR/setup.log" 8 56
          else
            dialog --title "Package installation failed" --textbox "$CONFIG_DIR/setup.log" 20 70
          fi
        fi
      fi ;;
    git)
      git_name=$(git config --global user.name 2>/dev/null || printf '')
      git_email=$(git config --global user.email 2>/dev/null || printf '')
      git_name=$(dialog --stdout --title "Git identity" --inputbox "Git user.name (leave blank to skip):" 10 60 "$git_name") || continue
      git_email=$(dialog --stdout --title "Git identity" --inputbox "Git user.email (leave blank to skip):" 10 60 "$git_email") || continue
      command -v git >/dev/null 2>&1 || { dialog --title "Git missing" --msgbox "Install git from step 3 first." 7 42; continue; }
      [ -z "$git_name" ] || git config --global user.name "$git_name"
      [ -z "$git_email" ] || git config --global user.email "$git_email"
      dialog --title "Git settings" --msgbox "Git identity settings saved where provided." 7 50 ;;
    workspace)
      old="${HOME:-/root}/workspace"
      path=$(dialog --stdout --title "Workspace" --inputbox "Directory to create and use:" 10 62 "$old") || continue
      [ -n "$path" ] || continue
      if mkdir -p "$path"; then
        tmp="$CONFIG_DIR/settings.tmp.$$"; awk -F= '$1 != "WORKSPACE" {print}' "$SETTINGS" > "$tmp"
        printf 'WORKSPACE=%s\n' "$path" >> "$tmp"; mv "$tmp" "$SETTINGS"
        dialog --title "Workspace saved" --msgbox "Created: $path" 7 48
      else dialog --title "Error" --msgbox "Could not create that directory." 7 44; fi ;;
    updates)
      auto=$(dialog --stdout --title "Update preference" --menu "Automatic update checks are not run in the background. Choose startup behavior:" 12 62 2 "manual" "Manual updates only" "notify" "Show update reminder at startup" 3>&1 1>&2 2>&3) || continue
      tmp="$CONFIG_DIR/settings.tmp.$$"; awk -F= '$1 != "UPDATE_MODE" {print}' "$SETTINGS" > "$tmp"
      printf 'UPDATE_MODE=%s\n' "$auto" >> "$tmp"; mv "$tmp" "$SETTINGS"
      dialog --title "Saved" --msgbox "Update preference saved." 7 42 ;;
    diagnostics)
      info="Shell: $(readlink /bin/sh 2>/dev/null || echo /bin/sh)\nArchitecture: $(uname -m 2>/dev/null || echo unknown)\nKernel: $(uname -r 2>/dev/null || echo unknown)\napk: $(command -v apk 2>/dev/null || echo missing)\ncurl: $(command -v curl 2>/dev/null || echo missing)\ndialog: $(command -v dialog 2>/dev/null || echo missing)\ngit: $(command -v git 2>/dev/null || echo missing)\n\nEnvironment: iSH / Alpine userland"
      dialog --title "Diagnostics" --msgbox "$info" 18 62 ;;
    finish) exit 0 ;;
  esac
done
