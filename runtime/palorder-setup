#!/bin/sh
set -eu
CONFIG_DIR="/root/.config/palorder"
mkdir -p "$CONFIG_DIR"
while :; do
  choice=$(dialog --clear --title "Setup assistant" --menu "Review the environment or install common tools." 16 62 6 \
    "check" "Check environment" "tools" "Install developer tools" "identity" "Set display name" "back" "Return to main menu" 3>&1 1>&2 2>&3) || exit 0
  case "$choice" in
    check)
      info="Shell: $(readlink /bin/sh 2>/dev/null || echo /bin/sh)\nArchitecture: $(uname -m 2>/dev/null || echo unknown)\nKernel: $(uname -r 2>/dev/null || echo unknown)\napk: $(command -v apk 2>/dev/null || echo missing)\ncurl: $(command -v curl 2>/dev/null || echo missing)\ndialog: $(command -v dialog 2>/dev/null || echo missing)\n\niSH supports a subset of Linux behavior."
      dialog --title "Environment check" --msgbox "$info" 16 60 ;;
    tools)
      if dialog --title "Developer tools" --yesno "Install git, python3, py3-pip, nano, less, openssh-client and ca-certificates?" 10 60; then
        apk add --no-cache git python3 py3-pip nano less openssh-client ca-certificates
        dialog --title "Setup complete" --msgbox "apk finished. Review any errors printed in the terminal." 8 56
      fi ;;
    identity)
      old="Palorder User"; [ ! -f "$CONFIG_DIR/identity" ] || old=$(cat "$CONFIG_DIR/identity")
      name=$(dialog --stdout --title "Display name" --inputbox "Name shown by Palorder:" 10 56 "$old") || continue
      [ -n "$name" ] || name="Palorder User"
      printf '%s\n' "$name" > "$CONFIG_DIR/identity"
      dialog --title "Saved" --msgbox "Display name updated." 7 40 ;;
    back) exit 0 ;;
  esac
done
