#!/bin/sh
set -eu
BIN_DIR="/root/bin"
CONFIG_DIR="/root/.config/palorder"
[ -x "$BIN_DIR/palorder-boot" ] && "$BIN_DIR/palorder-boot"
command -v dialog >/dev/null 2>&1 || { printf '%s\n' "Palorder requires dialog. Install it with: apk add dialog"; exec sh; }
while :; do
  theme="midnight"
  [ ! -f "$CONFIG_DIR/settings" ] || theme=$(sed -n 's/^THEME=//p' "$CONFIG_DIR/settings" | head -n 1)
  case "$theme" in
    violet) accent="\Zb\Z5" ;;
    amber) accent="\Zb\Z3" ;;
    emerald) accent="\Zb\Z2" ;;
    mono) accent="\Zb\Z7" ;;
    *) accent="\Zb\Z6" ;;
  esac
  choice=$(dialog --colors --clear --backtitle "${accent}PALORDER • BOOT MANAGER\Zn" --title "Palorder Boot Menu" --menu "\n  Use ↑/↓ and Enter to choose a session.\n  GRUB-inspired menu for the iSH environment.\n" 20 70 9 \
    "terminal" "Terminal session" \
    "control" "Control Center" \
    "setup" "First-run setup wizard" \
    "packages" "Package manager" \
    "utilities" "System utilities and diagnostics" \
    "task" "Run a command" \
    "update" "Update / repair Palorder" \
    "safe" "Safe shell (skip Palorder UI)" \
    "exit" "Exit to shell" 3>&1 1>&2 2>&3) || exit 0
  case "$choice" in
    terminal) "$BIN_DIR/palorder-terminal" ;;
    control) "$BIN_DIR/palorder-control" ;;
    setup) "$BIN_DIR/palorder-setup" ;;
    packages) "$BIN_DIR/palorder-packages" ;;
    utilities) "$BIN_DIR/palorder-utilities" ;;
    task) "$BIN_DIR/palorder-run-task" ;;
    update) "$BIN_DIR/palorder-update" ;;
    safe) clear 2>/dev/null || :; exec sh ;;
    exit) clear 2>/dev/null || :; exit 0 ;;
  esac
done
