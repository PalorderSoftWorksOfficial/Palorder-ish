#!/bin/sh
set -eu
APP_ROOT="${HOME:-/root}/.local/share/palorder/apps"
HOST="/root/bin/palorder-lua-host"
find_lua() {
  for candidate in lua5.4 lua54 lua; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    version=$("$candidate" -v 2>&1 || :)
    case "$version" in *"5.4"*) printf '%s\n' "$candidate"; return 0 ;; esac
  done
  return 1
}
ensure_runtime() {
  LUA_BIN=$(find_lua 2>/dev/null || :)
  if [ -n "$LUA_BIN" ] && command -v dialog >/dev/null 2>&1; then return 0; fi
  printf '%s\n' "Checking Lua Application Center requirements: Lua 5.4 and dialog..."
  if ! command -v apk >/dev/null 2>&1; then
    printf '%s\n' "apk is unavailable; this launcher expects Alpine/iSH." >&2
    return 1
  fi
  if ! apk add --no-cache lua5.4 dialog; then
    printf '%s\n' "Package install failed; refreshing Alpine indexes and retrying..."
    apk update || {
      printf '%s\n' "Could not refresh Alpine indexes. Check network and /etc/apk/repositories." >&2
      return 1
    }
    apk add --no-cache lua5.4 dialog || {
      printf '%s\n' "Could not install Lua 5.4 and dialog. Check package availability with: apk search lua" >&2
      return 1
    }
  fi
  LUA_BIN=$(find_lua) || {
    printf '%s\n' "The package install completed, but no Lua 5.4 interpreter was found." "Check package availability with: apk info -L lua5.4" >&2
    return 1
  }
  command -v dialog >/dev/null 2>&1 || {
    printf '%s\n' "dialog is still unavailable after package installation." >&2
    return 1
  }
  printf 'Runtime ready. Lua interpreter: %s\n' "$LUA_BIN"
}
usage() {
  cat <<'HELP'
palorder-app — manage Lua applications

Usage:
  palorder-app                 Open the interactive Application Center
  palorder-app list            List installed app IDs
  palorder-app run APP_ID      Run an installed app
  palorder-app create APP_ID   Create a starter app and manifest
  palorder-app info APP_ID     Show app metadata and paths
  palorder-app permissions APP_ID  Show requested/granted capabilities
  palorder-app revoke APP_ID storage  Reset storage permission consent
  palorder-app --help          Show this help

Apps live in ~/.local/share/palorder/apps/APP_ID/{manifest,main.lua}.
IDs match ^[a-z][a-z0-9_-]{0,47}$. Review app source before running it.
The runtime removes direct os/io/debug/package access and has no public
arbitrary-shell API. This is not a separate OS-user sandbox.
HELP
}
valid_id() { printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9_-]{0,47}$'; }
run_ui() {
  if ! ensure_runtime; then
    if command -v dialog >/dev/null 2>&1; then
      dialog --title "Lua runtime unavailable" --msgbox "Palorder could not install Lua 5.4. Check network access and Alpine repositories, then run: apk update && apk add lua5.4" 10 68
    fi
    return 1
  fi
  while :; do
    choice=$(dialog --clear --title "Lua Application Center" --menu "Run local Lua apps or create a new app." 15 64 5 \
      "list" "List installed apps" "run" "Run an app by ID" "create" "Create a Lua app" "help" "Command/API help" "exit" "Return to desktop" 3>&1 1>&2 2>&3) || return 0
    case "$choice" in
      list) result=$("$0" list); dialog --title "Installed Lua apps" --msgbox "$result" 18 64 ;;
      run)
        id=$(dialog --stdout --title "Run Lua app" --inputbox "App ID:" 9 52) || continue
        valid_id "$id" || { dialog --title "Invalid ID" --msgbox "Use lowercase letters, digits, underscore or hyphen; begin with a letter." 8 60; continue; }
        "$0" run "$id" ;;
      create)
        id=$(dialog --stdout --title "Create Lua app" --inputbox "New app ID:" 9 52) || continue
        valid_id "$id" || { dialog --title "Invalid ID" --msgbox "Use lowercase letters, digits, underscore or hyphen; begin with a letter." 8 60; continue; }
        "$0" create "$id"
        dialog --title "Lua app created" --msgbox "Edit ~/.local/share/palorder/apps/$id/main.lua, then choose Run app." 9 64 ;;
      help) "$0" --help | dialog --title "Lua application help" --programbox 22 72 ;;
      exit) return 0 ;;
    esac
  done
}
if [ "$#" -eq 0 ]; then
  run_ui
  exit 0
fi
case "$1" in
  --help|-h|help) usage ;;
  list)
    [ "$#" -eq 1 ] || { echo "Usage: palorder-app list" >&2; exit 2; }
    mkdir -p "$APP_ROOT"
    found=0
    for file in "$APP_ROOT"/*/main.lua; do
      [ -f "$file" ] || continue
      found=1
      printf '%s\n' "${file%/main.lua}" | sed "s|^$APP_ROOT/||"
    done
    [ "$found" -eq 1 ] || echo "No apps installed. Create one: palorder-app create hello"
    ;;
  run)
    [ "$#" -eq 2 ] || { echo "Usage: palorder-app run APP_ID" >&2; exit 2; }
    valid_id "$2" || { echo "Invalid APP_ID." >&2; exit 2; }
    ensure_runtime || exit 1
    [ -f "$HOST" ] || { echo "Lua host is missing: $HOST. Repair with: palorder-update" >&2; exit 1; }
    exec "$LUA_BIN" "$HOST" "$2"
    ;;
  create)
    [ "$#" -eq 2 ] || { echo "Usage: palorder-app create APP_ID" >&2; exit 2; }
    valid_id "$2" || { echo "Invalid APP_ID." >&2; exit 2; }
    dir="$APP_ROOT/$2"
    [ ! -e "$dir" ] || { echo "App already exists: $dir" >&2; exit 1; }
    mkdir -p "$dir"
    cat > "$dir/manifest" <<EOF
name=$2
version=0.1.0
permissions=storage
EOF
    cat > "$dir/main.lua" <<'LUA'
api.ui.message("Hello from Lua", "This app runs inside Palorder's restricted Lua environment.")
local previous = api.storage.get("launches") or "0"
local count = (tonumber(previous) or 0) + 1
api.storage.set("launches", tostring(count))
api.ui.message(api.app.name, "Launch count: " .. count .. "\nRuntime API: " .. api.version)
LUA
    chmod 600 "$dir/manifest" "$dir/main.lua"
    printf 'Created %s\nRun: palorder-app run %s\nEdit: %s/main.lua\n' "$dir" "$2" "$dir"
    ;;
  permissions)
    [ "$#" -eq 2 ] || { echo "Usage: palorder-app permissions APP_ID" >&2; exit 2; }
    valid_id "$2" || { echo "Invalid APP_ID." >&2; exit 2; }
    dir="$APP_ROOT/$2"
    [ -f "$dir/manifest" ] || { echo "App not found: $2" >&2; exit 1; }
    printf 'Manifest permissions: '
    sed -n 's/^permissions=//p' "$dir/manifest"
    grant="/root/.config/palorder/permissions/$2.storage"
    if [ -f "$grant" ]; then printf 'Storage decision: '; cat "$grant"; else echo "Storage decision: not asked yet"; fi
    ;;
  revoke)
    [ "$#" -eq 3 ] || { echo "Usage: palorder-app revoke APP_ID storage" >&2; exit 2; }
    valid_id "$2" || { echo "Invalid APP_ID." >&2; exit 2; }
    [ "$3" = storage ] || { echo "Supported permission: storage" >&2; exit 2; }
    rm -f "/root/.config/palorder/permissions/$2.storage"
    echo "Storage consent reset for $2. The app will ask again on its next launch."
    ;;
  info)
    [ "$#" -eq 2 ] || { echo "Usage: palorder-app info APP_ID" >&2; exit 2; }
    valid_id "$2" || { echo "Invalid APP_ID." >&2; exit 2; }
    dir="$APP_ROOT/$2"
    [ -f "$dir/main.lua" ] || { echo "App not found: $2" >&2; exit 1; }
    printf 'App: %s\nDirectory: %s\n\nManifest:\n' "$2" "$dir"
    cat "$dir/manifest" 2>/dev/null || :
    printf '\nSource: %s/main.lua\n' "$dir"
    ;;
  *) echo "Unknown subcommand: $1" >&2; usage >&2; exit 2 ;;
esac
