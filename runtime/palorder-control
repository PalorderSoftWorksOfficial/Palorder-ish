#!/bin/sh
set -eu
BIN_DIR="/root/bin"
while :; do
  term_size=$(stty size </dev/tty 2>/dev/null || printf '24 80')
  set -- $term_size
  rows=${1:-24}; cols=${2:-80}
  case "$rows:$cols" in *[!0-9:]*|'':*) rows=24; cols=80 ;; esac
  [ "$rows" -le 24 ] || rows=24; [ "$rows" -ge 14 ] || rows=14
  [ "$cols" -le 80 ] || cols=80; [ "$cols" -ge 36 ] || cols=36
  menu_h=$((rows - 8))
  choice=$(dialog --clear --title "Palorder Control Center" --menu "Workspace, development, device and runtime controls." "$rows" "$cols" "$menu_h" \
    "terminal" "Open terminal session" "apps" "Lua application manager" \
    "packages" "Package manager" "devtools" "Install developer toolchain" \
    "network" "Phone and network settings" "shell" "Choose default shell" \
    "history" "Release notes and commit registry" "check" "Check for updates" \
    "files" "Browse files (if available)" "editor" "Open text editor" \
    "monitor" "System / storage monitor" "settings" "Appearance and preferences" \
    "setup" "Setup wizard" "back" "Return to boot menu" 3>&1 1>&2 2>&3) || exit 0
  case "$choice" in
    terminal) "$BIN_DIR/palorder-terminal" ;;
    apps) "$BIN_DIR/palorder-app" ;;
    check) "$BIN_DIR/check-update" ;;
    packages) "$BIN_DIR/palorder-packages" ;;
    network) "$BIN_DIR/palorder-network" ;;
    shell) "$BIN_DIR/palorder-shell" ;;
    history) "$BIN_DIR/palorder-history" ;;
    devtools)
      if dialog --title "Developer toolchain" --yesno "Install Lua 5.4, Git, Python, pip, build tools, headers, curl, jq, nano, vim, tmux and OpenSSH? This downloads packages from configured Alpine repositories." 12 70; then
        if apk add --no-cache lua5.4 git python3 py3-pip build-base musl-dev linux-headers curl jq nano vim tmux openssh-client ca-certificates; then
          dialog --title "Developer tools" --msgbox "Installed. Lua apps: palorder-app --help\nUpdate checker: check-update --help" 9 60
        else dialog --title "Install failed" --msgbox "apk reported an error. Check repositories/network and retry." 8 56; fi
      fi ;;
    files)
      if command -v mc >/dev/null 2>&1; then mc
      elif command -v ranger >/dev/null 2>&1; then ranger
      else dialog --title "File browser unavailable" --msgbox "Install mc or ranger. Workspace defaults to /root/workspace." 9 62; fi ;;
    editor)
      if command -v vim >/dev/null 2>&1; then vim
      elif command -v nano >/dev/null 2>&1; then nano
      else dialog --title "Editor unavailable" --msgbox "Install nano or vim with apk first." 7 44; fi ;;
    monitor) info="System:\n$(uname -a 2>&1)\n\nStorage:\n$(df -h 2>&1)\n\nMemory:\n$(free -h 2>&1 || echo 'free is not installed')"; dialog --title "System monitor" --msgbox "$info" 22 72 ;;
    settings) "$BIN_DIR/palorder-settings" ;;
    setup) "$BIN_DIR/palorder-setup" ;;
    back) exit 0 ;;
  esac
done
