#!/bin/sh
set -eu
command_text=$(dialog --stdout --title "Run a command" --inputbox "Enter a shell command. Only run commands you understand:" 10 66) || exit 0
[ -n "$command_text" ] || exit 0
dialog --title "Confirm command" --yesno "Execute this command as the current iSH user?\n\n$command_text" 12 66 || exit 0
printf '\n$ %s\n\n' "$command_text"
set +e
sh -c "$command_text"
status=$?
set -e
dialog --title "Command finished" --msgbox "Exit status: $status" 8 42
exit "$status"
