#!/bin/sh
set -eu
CONFIG_DIR="/root/.config/palorder"
theme="midnight"
banner="1"
if [ -f "$CONFIG_DIR/settings" ]; then
  theme=$(sed -n 's/^THEME=//p' "$CONFIG_DIR/settings" | head -n 1)
  banner=$(sed -n 's/^SHOW_BANNER=//p' "$CONFIG_DIR/settings" | head -n 1)
fi
[ -n "$theme" ] || theme=midnight
[ -n "$banner" ] || banner=1
case "$theme" in
  violet) color='\033[1;35m' ;;
  amber) color='\033[1;33m' ;;
  emerald) color='\033[1;32m' ;;
  mono) color='\033[1;37m' ;;
  *) color='\033[1;36m' ;;
esac
command -v clear >/dev/null 2>&1 && clear || :
if [ "$banner" = 1 ]; then
  printf '%b' "$color"
  printf '%s\n' \
    '  ____       _                 _' \
    ' |  _ \__ _| | ___  _ __ __| | ___ _ __' \
    ' | |_) | | | |/ _ \| | | |/ _ \|' \
    ' |  __/ (_| | | (_) | | | (_| |  __/ |' \
    ' |_|   \__,_|_|\___/|_|  \__,_|\___|_|'
  printf '\033[0m'
fi
name="Palorder User"
[ ! -f "$CONFIG_DIR/identity" ] || name=$(cat "$CONFIG_DIR/identity")
printf '\n  %bPALORDER iSH ENVIRONMENT\033[0m\n' "$color"
printf '  Welcome, %s\n' "$name"
printf '  A focused command-line workspace for iOS\n\n'
uname -sr 2>/dev/null || printf 'Alpine userland'
printf '\n\n'
