#!/bin/sh
set -eu
BASE="https://raw.githubusercontent.com/PalorderSoftWorksOfficial/Palorder-ish/main"
BIN_DIR="/root/bin"
CONFIG_DIR="/root/.config/palorder"
STAMP=$(date +%Y%m%d-%H%M%S 2>/dev/null || echo update)
BACKUP_DIR="$CONFIG_DIR/backups/update-$STAMP"
FILES="palorder palorder-boot palorder-ui palorder-setup palorder-settings palorder-packages palorder-update palorder-run-task palorder-utilities palorder-terminal palorder-control palorder-lua-host palorder-app check-update palorder-version"
command -v curl >/dev/null 2>&1 || { printf '%s\n' "curl is required."; exit 1; }
mkdir -p "$BIN_DIR" "$CONFIG_DIR"
tmpdir="$CONFIG_DIR/update.$$"; mkdir -p "$tmpdir"
cleanup() { rm -rf "$tmpdir"; }; trap cleanup EXIT HUP INT TERM
for file in $FILES; do
  printf 'Fetching %s...\n' "$file"
  curl -fLsS --connect-timeout 15 --max-time 120 "$BASE/$file" -o "$tmpdir/$file" || { printf 'Update aborted: could not fetch %s; installed files were not changed.\n' "$file" >&2; exit 1; }
  [ -s "$tmpdir/$file" ] || { printf 'Update aborted: empty file %s; installed files were not changed.\n' "$file" >&2; exit 1; }
  chmod 755 "$tmpdir/$file"
done
mkdir -p "$BACKUP_DIR"
for file in $FILES; do [ ! -f "$BIN_DIR/$file" ] || cp -p "$BIN_DIR/$file" "$BACKUP_DIR/$file"; done
for file in $FILES; do mv "$tmpdir/$file" "$BIN_DIR/$file"; done
cp "$BIN_DIR/palorder-version" "$CONFIG_DIR/version"
printf '%s\n' "Runtime updated. Previous files backed up to $BACKUP_DIR." "Your preferences and display name were not changed."
